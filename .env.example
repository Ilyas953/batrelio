# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only: bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_.
# Supabase: Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...

# Public address of the app (https, no trailing slash). Twilio calls the webhooks there and
# SMS links point to it. Defaults to https://batrelio.com on the Vercel production deployment.
# In development, use a tunnel such as ngrok: localhost is unreachable from Twilio.
SITE_URL=https://batrelio.com

# Twilio: Console > Account info. The auth token also signs webhooks: keep it secret.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# French numbers require an approved regulatory bundle (Console > Phone Numbers > Regulatory Compliance).
TWILIO_BUNDLE_SID=BU...
TWILIO_ADDRESS_SID=AD...
# Numbers are bought in the area of the bundle address, e.g. +331 (Île-de-France) or +339.
TWILIO_NUMBER_PREFIX=+339
# Registered sender used while an artisan's own sender name awaits registration (optional).
SMS_FALLBACK_SENDER=BATRELIO
